{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-bytheway",
  "version": "0.8.0-beta.3",
  "description": "OpenCode TUI plugin based on Claude Code's \"btw\" feature",
  "author": "Tim Richardson",
  "homepage": "https://github.com/timrichardson/opencode-btw",
  "bugs": {
    "url": "https://github.com/timrichardson/opencode-btw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timrichardson/opencode-btw.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "main": "./dist/tui.js",
  "exports": {
    ".": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "oc-plugin": [
    "tui"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test:integration:v1": "OPENCODE_BTW_INTEGRATION=1 bun test ./integration.tui.test.ts",
    "test:integration:v2": "OPENCODE_BTW_V2_INTEGRATION=1 bun test ./integration.v2.test.ts",
    "test:integration": "bun run test:integration:v1 && bun run test:integration:v2",
    "test": "NODE_ENV=production bun test --preload @opentui/solid/runtime-plugin-support --conditions=browser ./tui.test.tsx ./v2.test.ts ./contract.test.ts",
    "prepublishOnly": "bun run typecheck && bun run build && bun run test"
  },
  "dependencies": {
    "@opentui/core": "^0.3.4",
    "@opentui/solid": "^0.3.4",
    "solid-js": "1.9.12"
  },
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "btw"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "0.0.0-next-17055",
    "@opencode-ai/plugin-v1": "npm:@opencode-ai/plugin@1.18.15",
    "@types/bun": "^1.3.14",
    "typescript": "5.8.2"
  }
}
